# 复制为 learning/.env（已在 .gitignore 里），或用 ENGLISH_ENV_FILE 指向别处。

# 数据目录：cards.db、gaps.jsonl、words.jsonl 都在这里。Easydict 设置里的「生词本目录」指向同一个目录。
ENGLISH_DATA_DIR=
# 日志目录，默认 $ENGLISH_DATA_DIR/logs
# ENGLISH_LOG_DIR=

# 飞书自建应用（机器人）凭证：remind.py 发学习提醒用
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 接收提醒的用户 open_id
FEISHU_USER_OPEN_ID=

# 飞书用户身份 token 文件（sync-bitable.py / render-vocab.py 读写多维表格用）
# JSON 格式，含 access_token 字段；需要自己做 OAuth 授权并定时刷新
FEISHU_UAT_FILE=

# 生词本网页的 data.json 推送目标（rsync 目标），如 myserver:/var/www/vocab/data.json
VOCAB_REMOTE=
# 练习记录回拉源，如 myserver:/var/lib/vocab/transcripts/
VOCAB_TRANSCRIPTS_REMOTE=
