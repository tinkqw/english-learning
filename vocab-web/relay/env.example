# 复制为服务器上的 .env（chmod 600），由 systemd EnvironmentFile 读入。
# 火山引擎「豆包端到端实时语音大模型」控制台 → 服务接口认证信息
VOLC_APP_ID=
# 注意：这里填的是 Access Token，不是「API 管理」里创建的 API Key（填错会 401 grant not found）
VOLC_API_KEY=

# 页面登录密码：存加盐 SHA-256，不存明文。生成方法：
#   SALT=$(openssl rand -hex 16); echo -n "${SALT}你的密码" | sha256sum
VOLC_PAGE_PASS_SALT=
VOLC_PAGE_PASS_HASH=

# 可选
# LISTEN_PORT=8787
# TRANSCRIPT_DIR=/var/lib/vocab/transcripts
